            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "document",
                  "type": "file",
                  "src": [],
                  "description": "Choose prescription, lab test, or medical report image/pdf"
                },
                {
                  "key": "patientId",
                  "value": "{{patientId}}",
                  "type": "text"
                },
                {
                  "key": "documentType",
                  "value": "prescription",
                  "type": "text"
                },
                {
                  "key": "notes",
