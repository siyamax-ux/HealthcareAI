                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symptoms\": [\"shortness of breath\", \"high fever\"],\n  \"vitals\": {\n    \"temperature\": 39.5,\n    \"oxygenLevel\": 90\n  }\n}"
