{
  "info": {
    "_postman_id": "c1f71df4-ecb4-4e2a-bb33-728b1bf0280c",
    "name": "SetuHealth AI API",
    "description": "API collection for SetuHealth AI. Set the `baseUrl` collection variable to point to your backend. The login requests automatically set the `token` collection variable on success.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramsevak Kumar\",\n  \"email\": \"patient@demo.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"password\": \"demo1234\",\n  \"role\": \"patient\",\n  \"village\": \"Sonbhadra, UP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create a new user profile with patient, doctor, or health_worker role."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.token) {",
                  "    pm.collectionVariables.set(\"token\", res.token);",
                  "    console.log(\"Token saved successfully!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"worker@demo.com\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in the user and automatically saves the auth Bearer token to the collection variables for future requests."
          },
          "response": []
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Gets current user details from JWT token."
          },
          "response": []
        }
      ]
    },
