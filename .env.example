# ─────────────────────────────────────────────────────────
#  SetuHealth AI — Environment Variables
#  Copy this file to .env for local development.
#  Set these in the Vercel dashboard under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────
# Required. Get your connection string from MongoDB Atlas.
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/setuhealth?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Required. Use a long random string (min 32 chars).
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=30d

# ── Gemini AI ─────────────────────────────────────────────
# Required for AI analysis. Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Node Environment ──────────────────────────────────────
NODE_ENV=production

# ── CORS (optional) ───────────────────────────────────────
# Add your custom domain here if you have one (e.g. https://setuhealth.in).
# The Vercel domain (setuhealthai.vercel.app) is already allowlisted in code.
# ALLOWED_ORIGIN=https://your-custom-domain.com

# ── Frontend API URL (Vite build) ─────────────────────────
# Set this in Vercel as well so the React build knows where the API lives.
# On Vercel, frontend and backend are the same origin, so /api works as a relative path.
# Leave blank or set to /api when deploying frontend and backend together on Vercel.
VITE_API_BASE_URL=/api

# ── Local dev only (not needed on Vercel) ─────────────────
# Override the backend proxy target during local development.
# VITE_DEV_PROXY_TARGET=http://localhost:5000
